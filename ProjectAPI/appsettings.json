{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CS": "YOUR_DATABASE_CONNECTION_STRING"
  },
  "JWT": {
    "SecretKey": "YOUR_JWT_SECRET_KEY",
    "IssuerIP": "YOUR_JWT_ISSUER",
    "AudienceIP": "YOUR_JWT_AUDIENCE"
  },
  "stripe": {
    "SecretKey": "YOUR_STRIPE_SECRET_KEY",
    "Publishablekey": "YOUR_STRIPE_PUBLISHABLE_KEY"
  },
  "StripeSettings": {
    "Domain": "YOUR_APPLICATION_DOMAIN"
  }
}